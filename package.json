{
  "name": "localbase",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/admin",
    "packages/cli",
    "packages/sdk",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build:admin && npm run build --workspaces",
    "build:admin": "npm run build --workspace @localbase/admin",
    "clean": "npm run clean --workspaces",
    "verify:admin-bundle": "npm run verify:admin-bundle --workspace @localbase/core",
    "admin:dev": "npm run dev --workspace @localbase/admin",
    "admin:build": "npm run build --workspace @localbase/admin"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
