{
  "name": "@localbase/cli",
  "version": "0.1.0",
  "description": "LocalBase CLI — init, migrate, dev server, studio, auth, and admin commands",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reyanshdagoat9113/localbase.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/reyanshdagoat9113/localbase#readme",
  "bugs": {
    "url": "https://github.com/reyanshdagoat9113/localbase/issues"
  },
  "keywords": [
    "localbase",
    "cli",
    "sqlite",
    "backend",
    "dev-server",
    "admin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "localbase": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@localbase/core": "0.1.0",
    "@localbase/shared": "0.1.0",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
