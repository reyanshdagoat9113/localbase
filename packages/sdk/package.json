{
  "name": "@localbase/sdk",
  "version": "0.1.0",
  "description": "TypeScript client SDK for LocalBase — query builder, auth, realtime, and Storage",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reyanshdagoat9113/localbase.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/reyanshdagoat9113/localbase#readme",
  "bugs": {
    "url": "https://github.com/reyanshdagoat9113/localbase/issues"
  },
  "keywords": [
    "localbase",
    "sdk",
    "client",
    "sqlite",
    "realtime",
    "auth",
    "storage"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@localbase/shared": "0.1.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.5",
    "@localbase/core": "0.1.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
