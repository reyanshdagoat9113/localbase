{
  "name": "@localbase/core",
  "version": "0.1.0-beta.2",
  "description": "LocalBase server runtime: SQLite, REST API, auth, realtime, Storage, Jobs, and Admin Studio",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reyanshdagoat9113/localbase.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/reyanshdagoat9113/localbase#readme",
  "bugs": {
    "url": "https://github.com/reyanshdagoat9113/localbase/issues"
  },
  "keywords": [
    "localbase",
    "sqlite",
    "backend",
    "rest-api",
    "auth",
    "realtime",
    "storage",
    "jobs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "copy:admin": "node build/copy-admin-bundle.mjs",
    "prebuild": "node build/copy-admin-bundle.mjs",
    "build": "tsup",
    "postbuild": "node build/copy-admin-bundle.mjs --force",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "node build/copy-admin-bundle.mjs --strict",
    "verify:admin-bundle": "node build/verify-admin-bundle.mjs",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@localbase/shared": "0.1.0-beta.2",
    "@node-rs/argon2": "^2.0.2",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.10.0",
    "croner": "^10.0.1",
    "hono": "^4.13.21",
    "jiti": "^2.7.0",
    "jose": "^6.2.3",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "pg": "^8.16.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@localbase/sdk": "0.1.0-beta.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.15.0",
    "pg": "^8.16.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
